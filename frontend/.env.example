# Only needed for a split deployment where the frontend is served from a
# different origin than the API. Leave unset for the normal setup: requests are
# relative, and Vite proxies /api to the backend in development.
# VITE_API_BASE_URL=

# Unused by the app: sign-in is a server-side flow and the browser never
# handles a Google token. Kept only because the deployment guide mentions it.
# VITE_GOOGLE_CLIENT_ID=
